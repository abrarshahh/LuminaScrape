# Model Configuration
DEFAULT_MODEL=groq/llama-3.1-8b-instant
ENABLE_FALLBACKS=true
FALLBACK_MODEL=ollama/deepseek-r1:8b

# Orchestration Settings
MAX_EXTRACTION_RETRIES=5
MAX_NAVIGATION_STEPS=6
NAVIGATION_LINK_LIMIT=80

# Provider API Keys
GROQ_API_KEY=
GEMINI_API_KEY=

# CAPTCHA Solver (optional)
CAPTCHA_PROVIDER=capsolver
CAPSOLVER_API_KEY=
